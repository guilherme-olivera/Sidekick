{
  "expo": {
    "name": "Sidekick",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sidekick-logo.png",
    "scheme": "sidekick",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/sidekick-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.sidekick.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sidekick-logo.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sidekick.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sidekick-logo.png",
          "color": "#ff6b6b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "guiii.olivera",
    "extra": {
      "API_URL": "https://sidekick-jtne.onrender.com",
      "router": {},
      "eas": {
        "projectId": "3b69b29e-876f-4286-8c61-339dddd6a282"
      }
    }
  }
}
