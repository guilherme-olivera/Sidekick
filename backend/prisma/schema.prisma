// Prisma schema for Sidekick
// Models: User, Workout, MoodCheck

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ===== USER MODEL =====
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password             String?   // null se usar OAuth Strava
  name                 String?
  avatar               String?   // URL da foto de perfil
  planType             String    @default("free")
  stravaId             String?   @unique // ID do atleta no Strava
  stravaAccessToken    String?
  stravaRefreshToken   String?
  stravaTokenExpiresAt DateTime?
  stravaAthleteName    String?
  stravaAthleteUsername String?
  stravaAthleteProfile String?
  pushToken            String?   // Token de notificação de push do dispositivo (Expo)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relações
  workouts       Workout[]
  moodChecks     MoodCheck[]
  profile        UserProfile?
  usageQuotas    UsageQuota[]
  calendarEvents CalendarEvent[]

  @@map("users")
}

// ===== WORKOUT MODEL =====
model Workout {
  id            String    @id @default(cuid())
  userId        String
  stravaId      String?   @unique // ID da atividade no Strava
  
  // Dados básicos
  title         String
  description   String?
  date          DateTime  // Data e hora do treino
  
  // Métricas
  duration      Int       // em segundos
  distance      Float?    // em km
  pace          Float?    // velocidade média (km/h)
  avgHeartRate  Int?      // BPM médio
  maxHeartRate  Int?      // BPM máximo
  averageCadence Float?   // Cadência média
  elevationGain Float?    // Ganho de elevação
  averageWatts  Float?    // Potência média (watts)
  movingTime    Int?      // Tempo em movimento (segundos)
  elapsedTime   Int?      // Tempo total decorrido (segundos)
  temperature   Float?    // Temperatura média
  sufferScore   Int?      // Score de sofrimento/esforço
  splits        Json?     // splits detalhados por km
  prCount       Int?      // Número de recordes pessoais (PRs) da atividade
  
  // Tipo e intensidade
  type          String    // "run", "cycling", "strength", etc
  intensity     String?   // "low", "moderate", "high"
  
  // Narrativa IA
  aiNarrative   String?   // Análise gerada pelo Gemini
  
  // Feedback subjetivo
  effortRating  Int?      // percepção de esforço de 1 a 5
  userNotes     String?   // notas subjetivas do usuário sobre o treino
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relação
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workouts")
  @@index([userId])
  @@index([date])
}

// ===== MOOD CHECK MODEL =====
model MoodCheck {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @db.Date // Apenas a data, sem hora
  
  // Emoção (um por dia)
  mood          String    // "tired", "sick", "normal", "angry", "sad", "happy"
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relação
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mood_checks")
  @@unique([userId, date])  // Um humor por dia por usuário
  @@index([userId])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  trainingGoal  String?
  focusArea     String?
  injuryNote    String?
  availableTime String?
  trainingMood  String?
  
  // Customização do Sidekick
  aiGender        String?   // "neutral" | "male" | "female"
  aiPersonality   String?   // "calm" | "strict" | "tough"
  aiTone          String?   // "cold" | "serious" | "sarcastic" | "motivational" | "funny"
  companionName   String?   // Nome customizado do companheiro
  companionAvatar String?   // Avatar customizado do companheiro
  
  // Metas do Atleta
  birthday        String?   // "dd/mm/yyyy"
  goalType        String?   // "distance" | "pace"
  goalDistance    String?   // "5k" | "10k" | "15k" | "half_marathon" | "marathon" | "custom"
  goalTargetTime  String?   // ex: "00:45:00"
  
  // Detalhes Complementares
  experienceLevel String?   // "beginner" | "intermediate" | "advanced"
  weeklyFrequency Int?      // 2 | 3 | 4 | 5
  phoneNumber     String?   // Telefone do usuário
  gender          String?   // Gênero biológico ("male" | "female")
  
  isConfigured    Boolean   @default(false)
  
  // Análise Histórica Periódica (IA)
  historyAnalysis          String?   // Relatório gamificado gerado pela IA
  historyAnalysisUpdatedAt DateTime? // Data de atualização do relatório
  newConquestsJson         String?   // JSON contendo novas conquistas/PRs não visualizados

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UsageQuota {
  id          String   @id @default(cuid())
  userId      String
  feature     String
  used        Int      @default(0)
  limit       Int
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodStart])
  @@map("usage_quotas")
}

// ===== CALENDAR EVENT MODEL =====
model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        DateTime // Data do evento
  type        String   @default("reminder") // "reminder" | "workout_plan" | etc
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
  @@index([userId])
  @@index([date])
}

